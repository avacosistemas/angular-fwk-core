{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "baseUrl": "./",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@fwk": ["./src/index.ts"],
      "@fwk/*": ["./src/lib/*"],
      "@fwk-layout": ["./src/lib/layout/index.ts"],
      "@fwk-layout/*": ["./src/lib/layout/infrastructure/*"],
      "@angular/*": [
        "../../../perfil-cpau/node_modules/@angular/*"
      ],
      "@angular/cdk/*": [
        "../../../perfil-cpau/node_modules/@angular/cdk/*"
      ],
      "@angular/material/*": [
        "../../../perfil-cpau/node_modules/@angular/material/*"
      ],
      "rxjs": [
        "../../../perfil-cpau/node_modules/rxjs"
      ],
      "rxjs/*": [
        "../../../perfil-cpau/node_modules/rxjs/*"
      ],
      "date-fns": [
        "../../../perfil-cpau/node_modules/date-fns"
      ],
      "date-fns/*": [
        "../../../perfil-cpau/node_modules/date-fns/*"
      ],
      "ng-apexcharts": [
        "../../../perfil-cpau/node_modules/ng-apexcharts"
      ]
    }
  },
  "exclude": [
    "**/*.spec.ts",
    "**/test.ts",
    "**/*.mock.ts"
  ]
}
