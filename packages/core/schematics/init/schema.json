{
  "$schema": "http://json-schema.org/schema",
  "$id": "SchematicsFwkInit",
  "title": "@avacosistemas/core Init Schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "The name of the project.",
      "$default": {
        "$source": "projectName"
      }
    },
    "minimal": {
      "type": "boolean",
      "description": "If true, skips example CRUD and welcome page.",
      "default": false
    },
    "appName": {
      "type": "string",
      "description": "Application display name.",
      "default": "Aplicación"
    }
  },
  "required": []
}

