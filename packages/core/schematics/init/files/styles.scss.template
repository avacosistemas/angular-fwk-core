/* ------------------------------------------------------------------
 * Global styles
 * ------------------------------------------------------------------
 * @avacosistemas/core styles are loaded from node_modules via angular.json.
 *
 * Colors are configured in src/app/core/config/app.config.ts.
 * The AppComponent applies them as CSS variables automatically.
 *
 * To override any CSS variable, uncomment and change below.
 * These have higher specificity than AppComponent's injected styles.
 * ------------------------------------------------------------------ */
 
@import 'node_modules/@avacosistemas/core/assets/styles/tailwind.scss';
@import 'node_modules/@avacosistemas/core/assets/styles/themes.scss';
@import 'node_modules/@avacosistemas/core/assets/styles/main.scss';
@import 'node_modules/@avacosistemas/core/assets/styles/style.css';

@tailwind utilities;

/* ------------------------------------------------------------------
 * Brand Colors (:root)
 * ------------------------------------------------------------------ */
:root {
  /*
  --fwk-primary: #3b82f6;
  --fwk-primary-rgb: 59, 130, 246;
  --fwk-accent: #3b82f6;
  --fwk-accent-rgb: 59, 130, 246;
  */

  /* Color del sidebar / navegación vertical */
  --fwk-sidebar-bg: #18181b;
}

/* ------------------------------------------------------------------
 * Vinculación de Material MDC a las variables del :root
 * Conecta los componentes de Angular Material directamente a var(--fwk-primary).
 * ------------------------------------------------------------------ */
.theme-default,
.theme-default.light,
.theme-default .light,
.theme-default.dark,
.theme-default .dark {
  /* Botones, Checkboxes, Radios, Spinners y Tabs */
  .mat-primary,
  .mat-accent {
    --mdc-filled-button-container-color: var(--fwk-primary) !important;
    --mdc-filled-button-label-text-color: #ffffff !important;
    --mdc-protected-button-container-color: var(--fwk-primary) !important;
    --mdc-protected-button-label-text-color: #ffffff !important;
    --mdc-outlined-button-outline-color: var(--fwk-primary) !important;
    --mdc-outlined-button-label-text-color: var(--fwk-primary) !important;
    --mdc-text-button-label-text-color: var(--fwk-primary) !important;
    --mdc-checkbox-selected-focus-icon-color: var(--fwk-primary) !important;
    --mdc-checkbox-selected-hover-icon-color: var(--fwk-primary) !important;
    --mdc-checkbox-selected-icon-color: var(--fwk-primary) !important;
    --mdc-checkbox-selected-pressed-icon-color: var(--fwk-primary) !important;
    --mat-full-pseudo-checkbox-selected-icon-color: var(--fwk-primary) !important;
    --mdc-radio-selected-focus-icon-color: var(--fwk-primary) !important;
    --mdc-radio-selected-hover-icon-color: var(--fwk-primary) !important;
    --mdc-radio-selected-icon-color: var(--fwk-primary) !important;
    --mdc-radio-selected-pressed-icon-color: var(--fwk-primary) !important;
    --mdc-circular-progress-active-indicator-color: var(--fwk-primary) !important;
    --mat-tab-header-active-label-text-color: var(--fwk-primary) !important;
    --mdc-tab-indicator-active-indicator-color: var(--fwk-primary) !important;
  }

  /* Form Fields al enfocar (etiqueta, borde y cursor) */
  .mat-mdc-form-field.mat-focused {
    --mat-form-field-focus-label-color: var(--fwk-primary) !important;
    --mdc-text-field-focus-label-text-color: var(--fwk-primary) !important;
    --mdc-text-field-focus-outline-color: var(--fwk-primary) !important;
    --mdc-text-field-caret-color: var(--fwk-primary) !important;

    .mdc-floating-label,
    .mat-mdc-floating-label {
      color: var(--fwk-primary) !important;
    }
  }

  /* Asegura iconos blancos en botones con fondo relleno */
  .mat-mdc-unelevated-button.mat-primary,
  .mat-mdc-unelevated-button.mat-accent,
  .mat-mdc-raised-button.mat-primary,
  .mat-mdc-raised-button.mat-accent {
    .mat-icon {
      color: #ffffff !important;
      fill: #ffffff !important;
    }
  }

  /* Borde y color de botones stroked */
  .mat-mdc-outlined-button.mat-primary,
  .mat-mdc-outlined-button.mat-accent {
    border-color: var(--fwk-primary) !important;
    color: var(--fwk-primary) !important;
  }
}

/* ------------------------------------------------------------------
 * Sidebar y Navegación Vertical
 * ------------------------------------------------------------------ */
fwk-vertical-navigation,
fwk-vertical-navigation.dark,
fwk-vertical-navigation.bg-gray-900,
fwk-vertical-navigation .fwk-vertical-navigation-wrapper,
fwk-vertical-navigation .fwk-vertical-navigation-aside-wrapper {
  background-color: var(--fwk-sidebar-bg, #18181b) !important;
}

fwk-vertical-navigation {
  .fwk-vertical-navigation-item-active,
  .fwk-vertical-navigation-item-active-forced {
    color: var(--fwk-primary) !important;
    .mat-icon {
      color: var(--fwk-primary) !important;
    }
  }
}

/* ------------------------------------------------------------------
 * Elementos de Shell y Utilitarios
 * ------------------------------------------------------------------ */
user button .bg-blue-600,
user .bg-blue-600,
.bg-blue-600 {
  background-color: var(--fwk-primary) !important;
}

.text-blue-600,
.text-blue-700 {
  color: var(--fwk-primary) !important;
}
