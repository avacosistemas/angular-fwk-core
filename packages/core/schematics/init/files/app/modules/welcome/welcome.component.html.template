<div class="flex flex-col flex-auto min-w-0 bg-[#F4F6FA] dark:bg-slate-950 min-h-full pb-16"
    *ngIf="user$ | async as user">
    <div class="flex-auto p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full space-y-8">

        <!-- Hero Banner -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-950 via-slate-900 to-indigo-950 p-6 sm:p-8 lg:p-10 shadow-2xl shadow-slate-950/40 text-white select-none border border-slate-800/80">

            <div class="absolute -top-24 -right-20 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-20 left-1/3 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">

                <div class="space-y-4 max-w-xl z-30">

                    <div class="flex flex-wrap items-center gap-2" *ngIf="userRole">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-slate-800/80 text-slate-200 border border-slate-700/60 backdrop-blur-md">
                            {{ userRole }}
                        </span>
                    </div>

                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white m-0">
                        {{ timeGreeting }}<ng-container *ngIf="userName">, {{ userName }}</ng-container>!<span class="inline-block hover:rotate-12 transition-transform duration-300">👋</span>
                    </h1>

                    <p class="text-slate-300/85 text-sm sm:text-base leading-relaxed font-normal m-0">
                        {{ bannerSubtitle }}
                    </p>
                </div>

                <div class="hidden md:flex items-center justify-end pr-2 lg:pr-6 pointer-events-none z-20">
                    <img [src]="appLogo" 
                        [alt]="appName" 
                        class="max-h-24 max-w-[200px] object-contain opacity-70 filter brightness-0 invert">
                </div>

            </div>
        </div>

        <!-- Quick Access Shortcuts -->
        <div *ngIf="shortcuts.length > 0" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">
            <a *ngFor="let shortcut of shortcuts" [routerLink]="[shortcut.route]"
                class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-sm transition-all flex items-center gap-3.5 group cursor-pointer"
                [ngClass]="{
                    'hover:border-purple-400 dark:hover:border-purple-600': shortcut.color === 'purple',
                    'hover:border-blue-400 dark:hover:border-blue-600': shortcut.color === 'blue' || shortcut.color === 'primary',
                    'hover:border-indigo-400 dark:hover:border-indigo-600': shortcut.color === 'indigo',
                    'hover:border-emerald-400 dark:hover:border-emerald-600': shortcut.color === 'emerald',
                    'hover:border-teal-400 dark:hover:border-teal-600': shortcut.color === 'teal',
                    'hover:border-rose-400 dark:hover:border-rose-600': shortcut.color === 'rose',
                    'hover:border-slate-400 dark:hover:border-slate-600': shortcut.color === 'slate'
                }">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform"
                    [ngClass]="{
                        'bg-purple-50 dark:bg-purple-950/60': shortcut.color === 'purple',
                        'bg-blue-50 dark:bg-blue-950/60': shortcut.color === 'blue' || shortcut.color === 'primary',
                        'bg-indigo-50 dark:bg-indigo-950/60': shortcut.color === 'indigo',
                        'bg-emerald-50 dark:bg-emerald-950/60': shortcut.color === 'emerald',
                        'bg-teal-50 dark:bg-teal-950/60': shortcut.color === 'teal',
                        'bg-rose-50 dark:bg-rose-950/60': shortcut.color === 'rose',
                        'bg-slate-100 dark:bg-slate-800': shortcut.color === 'slate'
                    }">
                    <mat-icon [svgIcon]="shortcut.icon"
                        class="!w-5 !h-5 sm:!w-6 sm:!h-6"
                        [ngClass]="{
                            'text-purple-600 dark:text-purple-400': shortcut.color === 'purple',
                            'text-blue-600 dark:text-blue-400': shortcut.color === 'blue' || shortcut.color === 'primary',
                            'text-indigo-600 dark:text-indigo-400': shortcut.color === 'indigo',
                            'text-emerald-600 dark:text-emerald-400': shortcut.color === 'emerald',
                            'text-teal-600 dark:text-teal-400': shortcut.color === 'teal',
                            'text-rose-600 dark:text-rose-400': shortcut.color === 'rose',
                            'text-slate-600 dark:text-slate-400': shortcut.color === 'slate'
                        }">
                    </mat-icon>
                </div>
                <div class="min-w-0">
                    <div class="text-[10px] sm:text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
                        {{ shortcut.title | translate }}
                    </div>
                    <div class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100 truncate transition-colors"
                        [ngClass]="{
                            'group-hover:text-purple-600 dark:group-hover:text-purple-400': shortcut.color === 'purple',
                            'group-hover:text-blue-600 dark:group-hover:text-blue-400': shortcut.color === 'blue' || shortcut.color === 'primary',
                            'group-hover:text-indigo-600 dark:group-hover:text-indigo-400': shortcut.color === 'indigo',
                            'group-hover:text-emerald-600 dark:group-hover:text-emerald-400': shortcut.color === 'emerald',
                            'group-hover:text-teal-600 dark:group-hover:text-teal-400': shortcut.color === 'teal',
                            'group-hover:text-rose-600 dark:group-hover:text-rose-400': shortcut.color === 'rose',
                            'group-hover:text-slate-600 dark:group-hover:text-slate-400': shortcut.color === 'slate'
                        }">
                        {{ shortcut.subtitle | translate }}
                    </div>
                </div>
            </a>
        </div>

        <!-- Sections & Cards -->
        <div class="space-y-8 pt-2">
            <ng-container *ngFor="let section of sections">
                <div class="space-y-4">

                    <div class="flex items-center gap-3">
                        <div *ngIf="section.icon"
                            class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-blue-100 border border-blue-200 dark:border-blue-800 dark:bg-blue-950/60 flex items-center justify-center shrink-0">
                            <mat-icon [svgIcon]="section.icon"
                                class="!w-5 !h-5 text-blue-600 dark:text-blue-400"></mat-icon>
                        </div>
                        <div>
                            <h2
                                class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 tracking-tight leading-tight m-0">
                                {{ section.title | translate }}
                            </h2>
                            <p *ngIf="section.subtitle"
                                class="mt-0.5 text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal m-0">
                                {{ section.subtitle | translate }}
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
                        <a *ngFor="let card of section.items" [routerLink]="[card.route]"
                            class="welcome-card group relative bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-2xs hover:border-blue-400 dark:hover:border-blue-600 hover:shadow-md transition-all flex flex-col justify-between cursor-pointer select-none min-h-[145px] sm:min-h-[155px]">

                            <div class="flex items-center justify-between gap-2 mb-3">
                                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 transition-transform group-hover:scale-105"
                                    [ngClass]="{
                                         'bg-blue-50 dark:bg-blue-950/60': card.color === 'primary' || card.color === 'blue',
                                         'bg-indigo-50 dark:bg-indigo-950/60': card.color === 'indigo',
                                         'bg-purple-50 dark:bg-purple-950/60': card.color === 'purple',
                                         'bg-emerald-50 dark:bg-emerald-950/60': card.color === 'emerald',
                                         'bg-teal-50 dark:bg-teal-950/60': card.color === 'teal',
                                         'bg-orange-50 dark:bg-orange-950/60': card.color === 'orange',
                                         'bg-amber-50 dark:bg-amber-950/60': card.color === 'amber',
                                         'bg-rose-50 dark:bg-rose-950/60': card.color === 'rose',
                                         'bg-slate-100 dark:bg-slate-800': card.color === 'slate'
                                     }">
                                    <mat-icon [svgIcon]="card.icon" class="!w-5 !h-5" [ngClass]="{
                                                  'text-blue-600 dark:text-blue-400': card.color === 'primary' || card.color === 'blue',
                                                  'text-indigo-600 dark:text-indigo-400': card.color === 'indigo',
                                                  'text-purple-600 dark:text-purple-400': card.color === 'purple',
                                                  'text-emerald-600 dark:text-emerald-400': card.color === 'emerald',
                                                  'text-teal-600 dark:text-teal-400': card.color === 'teal',
                                                  'text-orange-600 dark:text-orange-400': card.color === 'orange',
                                                  'text-amber-600 dark:text-amber-400': card.color === 'amber',
                                                  'text-rose-600 dark:text-rose-400': card.color === 'rose',
                                                  'text-slate-600 dark:text-slate-400': card.color === 'slate'
                                              }">
                                    </mat-icon>
                                </div>

                                <div class="flex items-center gap-2">
                                    <span *ngIf="card.badge"
                                        class="px-2.5 py-0.5 rounded-full text-[10px] sm:text-[11px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700">
                                        {{ card.badge | translate }}
                                    </span>

                                    <div
                                        class="w-8 h-8 rounded-full bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-slate-400 dark:text-slate-500 group-hover:bg-blue-50 dark:group-hover:bg-blue-950 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                                        <mat-icon svgIcon="heroicons_outline:chevron-right"
                                            class="!w-4 !h-4 group-hover:translate-x-0.5 transition-transform"></mat-icon>
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-1">
                                <h3
                                    class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors m-0 leading-snug">
                                    {{ card.title | translate }}
                                </h3>

                                <p
                                    class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal leading-relaxed m-0 line-clamp-2">
                                    {{ card.description | translate }}
                                </p>
                            </div>

                        </a>
                    </div>

                </div>
            </ng-container>
        </div>

    </div>
</div>
